# krakbot secrets and the single user-set value. Copy to `.env` and run:  chmod 600 .env
# The bot refuses to start if .env is readable by group/others or not owned by the running user.

# --- the only value you set: total capital in EUR (quote currency of all pairs) ---
CAPITAL=5000

# --- Kraken API key: permissions ONLY "Query Funds", "Query Open Orders & Trades", "Query Closed Orders & Trades",
#     "Create & Modify Orders", "Cancel/Close Orders", "Access WebSocket API". NEVER "Withdraw Funds".
#     Restrict the key to your VPS IP (IP whitelist) in Kraken Settings -> API.
#     Not needed for dry-run of public market data; required for live and for real fee-tier lookup.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Telegram alerts (optional but strongly recommended) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- external heartbeat / dead-man ping URL (optional, e.g. a cron-monitoring service). A dead process cannot alert:
#     only an external monitor can tell you the bot stopped. ---
HEALTHCHECK_URL=

# --- safety interlock for real orders. Live also requires the CLI flag and 7 clean DRY_RUN days recorded in the DB. ---
KRAKBOT_LIVE_ENABLED=false
