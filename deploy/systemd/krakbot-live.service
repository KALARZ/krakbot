# krakbot LIVE DCA. REAL ORDERS. Start only after `krakbot gate` passes and with your explicit OK (plan §5.3 canary).
# It refuses to start unless: config [strategies.dca].mode = "live", KRAKBOT_LIVE_ENABLED=true, API keys present,
# and the 7 pre-registered clean DRY_RUN days are in the DB (checked again inside the app).
# Install: see README.md "VPS". Logs: journalctl -u krakbot-live -o cat (one JSON object per line).
[Unit]
Description=krakbot DCA - LIVE (real orders on Kraken)
Documentation=file:///opt/krakbot/docs/runbook.md
Wants=network-online.target
After=network-online.target time-sync.target
Conflicts=krakbot.service
# with an ordering dependency, systemd finishes stopping the DRY_RUN (clean exit, run closed) before starting LIVE
After=krakbot.service
# at most 5 restarts in 15 minutes, then systemd gives up (the external heartbeat monitor alerts you)
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=krakbot
Group=krakbot
WorkingDirectory=/opt/krakbot
ExecStart=/opt/krakbot/.venv/bin/krakbot --config /opt/krakbot/config.toml --env /opt/krakbot/.env run --live --i-understand-live
# a refused start (gate not passed, exit 2) must not loop: only crashes and watchdog kills restart
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=15
# the main loop pings every 10 s while it is alive (healthy or not); 120 s of silence = hung -> SIGABRT + restart
WatchdogSec=120
TimeoutStartSec=120
TimeoutStopSec=30
KillSignal=SIGTERM
Environment=PYTHONUNBUFFERED=1
UMask=0077

# hardening: the bot needs outbound HTTPS/WSS and its data directory, nothing else
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/krakbot/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
